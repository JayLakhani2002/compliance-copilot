# .env.example — template for local secrets. Copy to `.env` (gitignored) and
# fill in real values. Never commit `.env` itself.

# Which provider make_llm() (graph/nodes.py) constructs: "openai" or
# "anthropic". Interim default "openai" (ADR-0002 amendment, 2026-08-24) —
# ADR-0002's actual target is "anthropic" once ANTHROPIC_API_KEY is bought.
LLM_PROVIDER=openai
# Optional: override the provider's default answer model (openai ->
# gpt-4.1-mini, anthropic -> claude-sonnet-5). Leave unset normally.
# ANSWER_MODEL=

# Anthropic (Claude) API key — used for the agent's reasoning/generation calls
# once LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# OpenAI API key — used for embeddings always, and for LLM calls while
# LLM_PROVIDER=openai.
OPENAI_API_KEY=

# App database (Postgres + pgvector) connection string, psycopg driver.
# Matches docker-compose.yml's postgres service user/password/db exactly —
# `make db-up` then this DATABASE_URL work together with no extra setup.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/compliance_copilot

# Langfuse public key — identifies this app to the Langfuse tracing project (safe to expose client-side).
# Unset (with LANGFUSE_SECRET_KEY) -> tracing.py's tracing_enabled() is False and every
# trace call is a no-op — no account exists yet, so this ships empty.
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key — server-side only, authenticates trace writes.
LANGFUSE_SECRET_KEY=

# Langfuse Cloud EU region base URL (AWS eu-west-1) — LANGFUSE_BASE_URL is the
# current env var name; LANGFUSE_HOST is deprecated upstream (still a fallback).
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# API's shared secret (X-API-Key header, src/compliance_copilot/api.py).
# Unset -> every request gets 503 "API_KEY not configured" (fail closed).
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=

# ADR-0019: guard_in's layer-2 cheap-LLM classifier (catches paraphrased/
# multilingual injection attacks the heuristic layer can't). Set to false to
# disable it entirely — the first knob to reach for if it's ever the
# suspect during an incident.
CLASSIFIER_ENABLED=true

# ADR-0020: guard_in's layer-3 PII redaction (Presidio) — names, emails,
# phone numbers, IBANs, credit cards, IPs in the question are swapped for a
# placeholder before retrieval/LLM/tracing ever see it. Set to false to
# disable — the one-line reversal for a redaction-related incident.
PII_REDACTION_ENABLED=true

# ADR-0023: the router (labels a question ai_act/gdpr/both/out_of_scope
# before retrieval) and the critic (checks the drafted answer's faithfulness
# to its own citations after answer, records only, does not block yet). Set
# either to false to disable it — the one-line reversal for each.
ROUTER_ENABLED=true
CRITIC_ENABLED=true

# --- Production only (docker-compose.prod.yml, ADR-0032) -------------------

# Public hostname Caddy issues a TLS cert for and reverse-proxies to `api`
# (Caddyfile's `{$DEPLOY_HOSTNAME}`), e.g. compliance-copilot.example.com.
# Unused in dev (no Caddy service in docker-compose.yml).
DEPLOY_HOSTNAME=

# ADR-0030: TrustedHostMiddleware's allowlist (settings.py's `allowed_hosts`,
# api.py). pydantic-settings parses a `list[str]` field from an env var as
# JSON (verified against installed pydantic-settings==2.15+, 2026-09-03 — a
# comma-separated string does NOT parse), so this MUST be JSON-array syntax,
# not comma-separated. A real deploy MUST set this to its actual public
# hostname(s) — the compiled-in default (localhost/127.0.0.1/testserver) has
# no wildcard and rejects every other Host header on purpose.
# ALLOWED_HOSTS=["compliance-copilot.example.com"]

# postgres service's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# (docker-compose.prod.yml) — MUST match DATABASE_URL's user/password/db
# above exactly, same decomposition reasoning as the dev docker-compose.yml.
# Dev's hardcoded user/password/compliance_copilot are throwaway values;
# a real deploy needs a real generated password here.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=compliance_copilot
