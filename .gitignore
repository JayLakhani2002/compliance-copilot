# .gitignore — tells git which files/folders never to track.
# chathistory/ is deliberately NOT listed here: CLAUDE.md requires it stay tracked
# so a new session can resume from the last handoff.

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyc

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv / venv
.venv/
venv/
uv.lock.bak

# Environment secrets — never commit real keys, only .env.example
.env
.env.*
!.env.example

# Local data + databases
data/raw/
*.db
*.sqlite3

# OS cruft
.DS_Store

# Editors
.vscode/
.idea/

# Terraform (infra/terraform/ — ADR-0033): local plan/provider cache, never
# committed. .terraform.lock.hcl IS committed (pins provider versions).
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local-only workflow/teaching files (kept on disk, never published)
TEACHER.md
PROMPT.md
CLAUDE.md
docs/CURRICULUM.md
docs/lessons/
docs/INBOX.md
docs/SETUP_SCREENS.md
docs/PROGRESS.md
chathistory/
docs/handoffs/
docs/posts/
